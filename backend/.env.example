# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'mysql'
DB_ENGINE=sqlite

# MySQL Database Settings (Required only when DB_ENGINE=mysql)
